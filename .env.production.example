# ============================================================================
# CareerOS — PRODUCTION environment template.
#
# IMPORTANT PRODUCTION NOTES
# ----------------------------------------------------------------------------
# 1. SECRETS MUST BE INJECTED BY THE HOSTING PROVIDER.
#    Do not bake secrets into images, repositories, or committed `.env` files.
#    Provide LLM_API_KEY (if a hosted LLM is used), API_KEY (backend auth), and
#    any vendor credentials through your platform's secret manager.
#
# 2. QDRANT URL MUST NOT BE PUBLIC WITHOUT AUTHENTICATION.
#    Keep Qdrant on a private network / VPC. If it must be exposed, put it
#    behind authenticated TLS termination. Never point QDRANT_URL at a public
#    unauthenticated instance.
#
# 3. CORS MUST BE RESTRICTED.
#    Set ALLOWED_ORIGINS to the exact frontend origin(s). Never use "*" in
#    production.
#
# 4. CONTACT INFORMATION SHOULD REMAIN HIDDEN.
#    Keep SHOW_CONTACT_INFORMATION=false so phone/email are not surfaced by
#    the public demo UI.
#
# 5. DEBUG ENDPOINTS MUST BE DISABLED.
#    Keep ENABLE_DEBUG_ENDPOINTS=false and LOG_LEVEL=INFO/WARNING.
#
# 6. API AUTHENTICATION SHOULD BE ENABLED BEFORE PUBLIC DEPLOYMENT.
#    Set API_KEY_ENABLED=true and API_KEY to a strong random value; clients must
#    then send `X-API-Key: <value>`. Add rate limiting at the reverse proxy.
# ============================================================================

APP_ENV=production
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Restrict CORS to your real frontend origin(s), comma separated.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Backend API authentication (enable before any public deployment).
API_KEY_ENABLED=true
API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

FRONTEND_PORT=8501
# Service-name based URL for the Docker network; do not use localhost here.
BACKEND_URL=http://backend:8000

# Private, authenticated Qdrant endpoint — not a public URL.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_os
# Managed/cloud Qdrant credential — inject via the secret manager, never commit.
QDRANT_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
KEYWORD_BOOST=0.15

# For a hosted LLM, inject LLM_API_KEY from the secret manager.
# For a local model, point LLM_BASE_URL at your private OpenAI-compatible server.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
LLM_MODEL=REPLACE_WITH_MODEL_NAME
LLM_API_KEY=REPLACE_VIA_SECRET_MANAGER
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

TOP_K_RETRIEVAL=20
TOP_N_RERANKED=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MIN_CHUNK_LENGTH=80

MAX_QUERY_LENGTH=2000
MAX_JOB_DESCRIPTION_LENGTH=12000
MAX_DOCUMENT_LENGTH=100000

PUBLIC_PROFILE_MODE=true
SHOW_CONTACT_INFORMATION=false
ENABLE_DEBUG_ENDPOINTS=false

# Public profile links (leave blank to hide).
GITHUB_URL=
LINKEDIN_URL=
PORTFOLIO_URL=

# Corpus and evaluation paths (relative to the repo root).
DATA_DIR=data/sample_docs
EVAL_FILE=data/eval/questions.json
