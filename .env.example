# ============================================================================
# CareerOS environment template — safe for local Docker development.
# Copy to `.env` before starting:  cp .env.example .env
# Never commit a real `.env` file and never put real API keys in these files.
# ============================================================================

APP_ENV=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS origins (comma separated). "*" is fine for local dev only —
# production requires explicit origins (enforced at startup).
ALLOWED_ORIGINS=*

# Optional backend auth: when enabled, clients must send X-API-Key.
API_KEY_ENABLED=false
API_KEY=

FRONTEND_PORT=8501
BACKEND_URL=http://backend:8000

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_os
# Only needed for managed/cloud Qdrant instances (leave blank locally).
QDRANT_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
# Bonus added to vector scores for exact keyword overlap (0.0–1.0).
KEYWORD_BOOST=0.15

LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=120

TOP_K_RETRIEVAL=20
TOP_N_RERANKED=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MIN_CHUNK_LENGTH=80

MAX_QUERY_LENGTH=2000
MAX_JOB_DESCRIPTION_LENGTH=12000
MAX_DOCUMENT_LENGTH=100000

PUBLIC_PROFILE_MODE=true
SHOW_CONTACT_INFORMATION=false
ENABLE_DEBUG_ENDPOINTS=false

GITHUB_URL=
LINKEDIN_URL=
PORTFOLIO_URL=

# Corpus and evaluation paths (relative to the repo root).
DATA_DIR=data/sample_docs
EVAL_FILE=data/eval/questions.json
