# ============================================================================
# CareerOS — DEVELOPMENT environment template.
#
# Copy to `.env` for local work:   cp .env.development.example .env
#
# Development-friendly settings: debug logging, local Docker service names,
# local OpenAI-compatible LLM endpoint (Ollama by default), debug endpoints on.
# Never put real API keys here.
# ============================================================================

APP_ENV=development
LOG_LEVEL=DEBUG

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS: wildcard is acceptable in development only.
ALLOWED_ORIGINS=*

# Optional backend auth (off by default in development).
API_KEY_ENABLED=false
API_KEY=

# Frontend talks to the backend over the Docker network (service name = backend).
FRONTEND_PORT=8501
BACKEND_URL=http://backend:8000

# Inside Docker, Qdrant is reached by service name, never localhost.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_os
# Managed/cloud Qdrant only — leave blank locally.
QDRANT_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
KEYWORD_BOOST=0.15

# Local OpenAI-compatible endpoint (Ollama). host.docker.internal resolves to the
# host machine from inside a container. For a bare-metal dev run use:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=180

TOP_K_RETRIEVAL=20
TOP_N_RERANKED=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MIN_CHUNK_LENGTH=80

MAX_QUERY_LENGTH=2000
MAX_JOB_DESCRIPTION_LENGTH=12000
MAX_DOCUMENT_LENGTH=100000

PUBLIC_PROFILE_MODE=true
SHOW_CONTACT_INFORMATION=false
ENABLE_DEBUG_ENDPOINTS=true

GITHUB_URL=
LINKEDIN_URL=
PORTFOLIO_URL=

# Corpus and evaluation paths (relative to the repo root).
DATA_DIR=data/sample_docs
EVAL_FILE=data/eval/questions.json
